@page
@model ObreshkovLibrary.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    Layout = null;
    ViewData["Title"] = "Забравена парола";

    bool isAdmin = Model.Input.Role == "Admin";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <partial name="_ValidationScriptsPartial" />
</head>

<body style="margin:0;
             font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
             background:linear-gradient(180deg,#EEF3FB 0%,#E2E8F0 100%);
             min-height:100vh;">

    <div style="min-height:100vh;
                display:flex;
                align-items:center;
                justify-content:center;
                padding:24px 16px;">

        <div style="width:100%;
                    max-width:520px;
                    background:white;
                    border:1px solid #DCE5F0;
                    border-radius:28px;
                    padding:34px;
                    box-shadow:0 20px 50px rgba(15,23,42,.08);">

            <h1 style="text-align:center;
                       font-size:2.2rem;
                       font-weight:900;
                       color:#0F172A;
                       margin:0;
                       letter-spacing:-0.03em;">
                Забравена парола
            </h1>

            <div style="width:64px;
                        height:4px;
                        border-radius:999px;
                        background:#3B82F6;
                        margin:14px auto 26px auto;">
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div style="margin-bottom:18px;
                                padding:14px 16px;
                                border-radius:16px;
                                border:1px solid #BFDBFE;
                                background:#EFF6FF;
                                color:#1D4ED8;
                                font-weight:700;
                                line-height:1.5;">
                    @Model.StatusMessage
                </div>
            }

            <form method="post"
                  style="display:flex;
                         flex-direction:column;">

                @Html.AntiForgeryToken()

                <input asp-for="Input.Role" type="hidden" />

                @if (isAdmin)
                {
                    <div style="color:#64748B;
                                    text-align:center;
                                    margin-bottom:24px;
                                    line-height:1.5;
                                    font-size:.97rem;">
                        Въведете служебния имейл за заявка за възстановяване.
                    </div>

                    <label asp-for="Input.Email"
                           style="display:block;
                                      margin-bottom:8px;
                                      font-weight:800;
                                      color:#334155;">
                        Имейл
                    </label>

                    <input asp-for="Input.Email"
                           placeholder="admin@obreshkov.bg"
                           style="width:100%;
                                      height:52px;
                                      border-radius:16px;
                                      border:1px solid #CBD5E1;
                                      background:white;
                                      padding:0 16px;
                                      font-size:1rem;
                                      box-sizing:border-box;
                                      margin-bottom:16px;" />

                    <span asp-validation-for="Input.Email"
                          style="display:block;
                                     margin-top:-10px;
                                     margin-bottom:14px;
                                     color:#DC2626;
                                     font-size:.9rem;
                                     font-weight:600;">
                    </span>
                }
                else
                {
                    <div style="color:#64748B;
                                    text-align:center;
                                    margin-bottom:24px;
                                    line-height:1.5;
                                    font-size:.97rem;">
                        Попълнете данните си за заявка за нова парола.
                    </div>

                    <label asp-for="Input.CardNumber"
                           style="display:block;
                                      margin-bottom:8px;
                                      font-weight:800;
                                      color:#334155;">
                        Номер на читателска карта
                    </label>

                    <input asp-for="Input.CardNumber"
                           placeholder="Само цифри"
                           style="width:100%;
                                      height:52px;
                                      border-radius:16px;
                                      border:1px solid #CBD5E1;
                                      background:white;
                                      padding:0 16px;
                                      font-size:1rem;
                                      box-sizing:border-box;
                                      margin-bottom:16px;" />

                    <span asp-validation-for="Input.CardNumber"
                          style="display:block;
                                     margin-top:-10px;
                                     margin-bottom:14px;
                                     color:#DC2626;
                                     font-size:.9rem;
                                     font-weight:600;">
                    </span>

                    <label asp-for="Input.PhoneNumber"
                           style="display:block;
                                      margin-bottom:8px;
                                      font-weight:800;
                                      color:#334155;">
                        Телефонен номер
                    </label>

                    <input asp-for="Input.PhoneNumber"
                           placeholder="08XXXXXXXX"
                           style="width:100%;
                                      height:52px;
                                      border-radius:16px;
                                      border:1px solid #CBD5E1;
                                      background:white;
                                      padding:0 16px;
                                      font-size:1rem;
                                      box-sizing:border-box;
                                      margin-bottom:16px;" />

                    <span asp-validation-for="Input.PhoneNumber"
                          style="display:block;
                                     margin-top:-10px;
                                     margin-bottom:14px;
                                     color:#DC2626;
                                     font-size:.9rem;
                                     font-weight:600;">
                    </span>
                }

                <div style="display:flex;
                            gap:12px;
                            margin-top:10px;">

                    <button type="submit"
                            style="flex:1;
                                   height:50px;
                                   border:none;
                                   border-radius:16px;
                                   background:linear-gradient(135deg,#2563EB 0%,#1D4ED8 100%);
                                   color:white;
                                   font-size:1rem;
                                   font-weight:800;
                                   cursor:pointer;
                                   box-shadow:0 10px 24px rgba(37,99,235,.24);">
                        Изпрати заявка
                    </button>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-role="@Model.Input.Role"
                       style="flex:1;
                              height:50px;
                              border-radius:16px;
                              border:1px solid #DCE5F0;
                              background:white;
                              display:flex;
                              align-items:center;
                              justify-content:center;
                              text-decoration:none;
                              color:#334155;
                              font-weight:700;">
                        Назад
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>